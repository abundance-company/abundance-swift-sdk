# Reference broker configuration — the values that make a deployment yours:
# the bearer token and, optionally, an object-store backend.
#
# Copy to broker.env (gitignored, chmod 600) beside this file and fill in.
# The broker binary reads only environment variables — no flags — so the same
# file serves every way of running it:
#
#   local run:        set -a; . deploy/broker.env; set +a; go run .
#   bench script:     scripts/bench-e2e.sh picks up ABUNDANCE_BROKER_TOKEN
#                     automatically
#   Fly deployment:   flyctl secrets import --app <app> < deploy/broker.env
#
# Run mechanics stay out of this file: ABUNDANCE_BROKER_LISTEN defaults to
# :8080 and ABUNDANCE_BROKER_STORAGE_DIR to ./broker-data, and the Fly
# machine overrides both in fly.toml's [env].

# Bearer token the device must present on announce and complete.
# Generate one: openssl rand -hex 32
ABUNDANCE_BROKER_TOKEN=replace-with-openssl-rand-hex-32

# --- Object-store backend (optional) -----------------------------------------
# Leave ABUNDANCE_S3_BUCKET empty and the broker stores artifacts on its own
# disk — no cloud involved. Set it and artifact PUTs go straight to the store
# through presigned URLs; only announcements touch the broker's disk. Works
# with anything speaking the S3 API (AWS, MinIO, R2, LocalStack) — point
# ABUNDANCE_S3_ENDPOINT at non-AWS services.
ABUNDANCE_S3_BUCKET=
AWS_REGION=
ABUNDANCE_S3_PREFIX=
ABUNDANCE_S3_ENDPOINT=
# IAM credentials. Least privilege: s3:PutObject + s3:GetObject on the prefix,
# s3:ListBucket on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
